   "source": [
    "#text length annalysis \n",
    "text_cols = [c for c in df.columns if df[c].dtype == 'object' and df[c].nunique() > 30]\n",
    "print('Text columns detected:', text_cols)\n",
    "\n",
    "for col in text_cols:\n",
    "    df[f'{col}_word_count'] = df[col].dropna().apply(lambda x: len(str(x).split()))\n",
    "    df[f'{col}_char_count'] = df[col].dropna().apply(lambda x: len(str(x)))\n",
    "\n",
    "    print(f'\\n--- {col} ---')\n",
    "    print(df[[f'{col}_word_count', f'{col}_char_count']].describe().round(1))\n",
    "    print(f'Word count skew: {df[f\"{col}_word_count\"].skew():.3f}')\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 3))\n",
    "    df[f'{col}_word_count'].hist(bins=40, ax=axes[0], color='steelblue')\n",
    "    axes[0].set_title(f'{col} — Word Count')\n",
    "    axes[0].set_xlabel('Words')\n",
    "\n",
    "    df[f'{col}_char_count'].hist(bins=40, ax=axes[1], color='coral')\n",
    "    axes[1].set_title(f'{col} — Char Count')\n",
    "    axes[1].set_xlabel('Characters')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
