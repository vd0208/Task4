   "source": [
    "#elbow plot and kmeans \n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.cluster import KMeans\n",
    "\n",
    "text_cols = [c for c in df.columns if df[c].dtype == 'object' and df[c].nunique() > 30]\n",
    "TEXT_COL = text_cols[0]  # uses the first detected text column\n",
    "print(f'Using text column: {TEXT_COL}')\n",
    "\n",
    "clean_docs = df[TEXT_COL].dropna().apply(\n",
    "    lambda x: ' '.join(clean_tokens(x))\n",
    ")\n",
    "\n",
    "tfidf = TfidfVectorizer(max_features=500)\n",
    "X = tfidf.fit_transform(clean_docs)\n",
    "\n",
    "inertias = []\n",
    "K_range = range(2, 11)\n",
    "for k in K_range:\n",
    "    km = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    km.fit(X)\n",
    "    inertias.append(km.inertia_)\n",
    "\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.plot(K_range, inertias, marker='o', color='steelblue')\n",
    "plt.title('Elbow Plot — KMeans on TF-IDF')\n",
    "plt.xlabel('k')\n",
    "plt.ylabel('Inertia')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
