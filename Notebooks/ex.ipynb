   "source": [
    "#cross tabulation\n",
    "cat_cols = [c for c in df.columns if df[c].dtype == 'object' and 2 < df[c].nunique() < 30]\n",
    "\n",
    "# All pairs of categorical columns (limit to meaningful ones)\n",
    "from itertools import combinations\n",
    "\n",
    "for col_a, col_b in combinations(cat_cols, 2):\n",
    "    ct = pd.crosstab(df[col_a], df[col_b])\n",
    "    if ct.shape[0] <= 10 and ct.shape[1] <= 10:  # skip huge tables\n",
    "        plt.figure(figsize=(10, 4))\n",
    "        sns.heatmap(ct, annot=True, fmt='d', cmap='Blues')\n",
    "        plt.title(f'{col_a} vs {col_b}')\n",
    "        plt.tight_layout()\n",
    "        plt.show()"
   ]
  },
