import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from collections import Counter
import re
from sklearn.feature_extraction.text import ENGLISH_STOP_WORDS, CountVectorizer

# ============================================================
# 1. Load Data
# ============================================================
df_raw = pd.read_csv("customer_support_tickets.csv", encoding='latin-1')
print(f"Dataset shape: {df_raw.shape}")

# ============================================================
# 2. Field Selection (retain all fields needed for analysis)
# ============================================================
df = df_raw[['Ticket Description', 'Ticket Type',
             'Customer Satisfaction Rating', 'Ticket Priority']].copy()
df.rename(columns={'Ticket Description': 'text'}, inplace=True)

# ============================================================
# 3. Data Cleaning
# ============================================================
print(f"Missing values in text: {df['text'].isnull().sum()}")
df = df.dropna(subset=['text'])
df = df.drop_duplicates(subset=['text'])
print(f"Records after deduplication: {len(df)}")

df['Customer Satisfaction Rating'] = pd.to_numeric(
    df['Customer Satisfaction Rating'], errors='coerce'
)
print(f"Satisfaction rating missing rate: {df['Customer Satisfaction Rating'].isnull().mean():.1%}")

# ============================================================
# 4. Text Cleaning (key step: remove template placeholders)
# ============================================================
CUSTOM_STOPWORDS = set(ENGLISH_STOP_WORDS) | {
    'productpurchased', 'im', 'ive', 'assist', 'having', 'product'
}

def clean_text(text):
    text = text.lower()
    # Remove template placeholders such as {product_purchased}
    text = re.sub(r'\{[^}]+\}', '', text)
    text = re.sub(r'[^a-z\s-]', '', text)
    text = re.sub(r'\s+', ' ', text).strip()
    return text

df['clean_text'] = df['text'].apply(clean_text)
df['length'] = df['clean_text'].apply(lambda x: len(x.split()))

# ============================================================
# 5. Text Length Analysis
# ============================================================
print("\n=== Text Length Statistics ===")
print(df['length'].describe())

plt.figure(figsize=(8, 4))
plt.hist(df['length'], bins=50, color='steelblue', edgecolor='white')
plt.title("Text Length Distribution")
plt.xlabel("Number of Words")
plt.ylabel("Frequency")
plt.tight_layout()
plt.show()

# ============================================================
# 6. Word Frequency Analysis (stop words + template words removed)
# ============================================================
all_words = " ".join(df['clean_text']).split()
filtered_words = [w for w in all_words if w not in CUSTOM_STOPWORDS and len(w) > 2]
top_filtered = Counter(filtered_words).most_common(20)

print("\n=== Top 20 Words (Stop Words + Template Words Removed) ===")
for word, count in top_filtered:
    print(f"  {word}: {count}")

words, counts = zip(*top_filtered)
plt.figure(figsize=(10, 5))
plt.barh(words[::-1], counts[::-1], color='steelblue')
plt.title("Top 20 Words (Stop Words + Template Words Removed)")
plt.xlabel("Frequency")
plt.tight_layout()
plt.show()

# ============================================================
# 7. Bigram Analysis
# ============================================================
vectorizer = CountVectorizer(ngram_range=(2, 2), stop_words='english',
                             token_pattern=r'\b[a-z]{3,}\b')
X = vectorizer.fit_transform(df['clean_text'])
sum_words = X.sum(axis=0)
words_freq = sorted(
    [(word, sum_words[0, idx]) for word, idx in vectorizer.vocabulary_.items()],
    key=lambda x: x[1], reverse=True
)

print("\n=== Top 20 Bigrams ===")
for bigram, count in words_freq[:20]:
    print(f"  {bigram}: {count}")

bg_words, bg_counts = zip(*words_freq[:20])
plt.figure(figsize=(10, 5))
plt.barh(bg_words[::-1], bg_counts[::-1], color='coral')
plt.title("Top 20 Bigrams")
plt.xlabel("Frequency")
plt.tight_layout()
plt.show()

# ============================================================
# 8. Ticket Type Distribution
# ============================================================
print("\n=== Ticket Type Distribution ===")
print(df['Ticket Type'].value_counts())

type_counts = df['Ticket Type'].value_counts()
plt.figure(figsize=(7, 7))
plt.pie(type_counts, labels=type_counts.index, autopct='%1.1f%%', startangle=140)
plt.title("Ticket Type Distribution")
plt.tight_layout()
plt.show()

# ============================================================
# 9. Ticket Priority Distribution
# ============================================================
print("\n=== Ticket Priority Distribution ===")
print(df['Ticket Priority'].value_counts())

priority_counts = df['Ticket Priority'].value_counts()
plt.figure(figsize=(6, 4))
priority_counts.plot(kind='bar', color='slateblue')
plt.title("Ticket Priority Distribution")
plt.ylabel("Count")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# ============================================================
# 10. Customer Satisfaction Analysis
# ============================================================
print("\n=== Satisfaction Rating by Ticket Type (mean / count / std) ===")
print(df.groupby('Ticket Type')['Customer Satisfaction Rating']
      .agg(['mean', 'count', 'std']).round(2))

# Satisfaction rating distribution
plt.figure(figsize=(6, 4))
df['Customer Satisfaction Rating'].value_counts().sort_index().plot(
    kind='bar', color='mediumseagreen')
plt.title("Satisfaction Rating Distribution")
plt.xlabel("Rating")
plt.ylabel("Count")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# Average satisfaction by ticket type
sat_by_type = df.groupby('Ticket Type')['Customer Satisfaction Rating'].mean()
plt.figure(figsize=(8, 4))
sat_by_type.sort_values().plot(kind='barh', color='mediumseagreen')
plt.title("Avg Customer Satisfaction by Ticket Type")
plt.xlabel("Average Rating")
plt.xlim(2.5, 3.2)  # Zoom in to reveal subtle differences
plt.tight_layout()
plt.show()

# ============================================================
# 11. Per-Type Word Frequency Comparison (template words removed)
# ============================================================
print("\n=== Top 10 Words per Ticket Type (template words removed) ===")
for ticket_type in df['Ticket Type'].unique():
    subset = df[df['Ticket Type'] == ticket_type]['clean_text']
    words = " ".join(subset).split()
    filtered = [w for w in words if w not in CUSTOM_STOPWORDS and len(w) > 2]
    print(f"\n{ticket_type}:", Counter(filtered).most_common(10))
